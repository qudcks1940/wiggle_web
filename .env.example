OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
WIGGLE_VOICE_WHISPER_ENABLED=false
WIGGLE_SUBSCRIPTIONS_ENABLED=false

# 실행 환경: 로컬은 아래 값을 사용한다. Vercel에서는 VERCEL_ENV가 Preview/Production을 결정한다.
WIGGLE_APP_ENV=local
WIGGLE_DATA_ENV=local

# 로컬에서는 원격 Turso/R2 값을 비워 둔다. Preview/Production 값은 Vercel의 각 환경 범위에 따로 등록한다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
R2_S3_ENDPOINT=
R2_S3_BUCKET=
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
WHISPER_RELAY_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
